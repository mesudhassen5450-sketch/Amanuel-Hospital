# =====================================================
# AMANUEL HOSPITAL - BACKEND SERVER ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git!

# -----------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_key_here

# -----------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------
# Get from Supabase: https://supabase.com/dashboard/project/_/settings/database
# Runtime pooler connection (Port 6543 with pgbouncer)
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"

# Direct connection (Port 5432 for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# -----------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------
# Frontend URL for CORS (development: http://localhost:8080)
# Production: https://your-frontend-domain.netlify.app
CORS_ORIGIN="http://localhost:8080"

# -----------------------------------------------------
# URL CONFIGURATION
# -----------------------------------------------------
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:8080"

# -----------------------------------------------------
# CHAPA PAYMENT GATEWAY (OPTIONAL)
# -----------------------------------------------------
# Get your keys from: https://dashboard.chapa.co/settings/api-keys
# Use TEST keys for development, LIVE keys for production
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-your_public_key_here"
CHAPA_SECRET_KEY="CHASECK_TEST-your_secret_key_here"
CHAPA_ENCRYPTION_KEY="your_encryption_key_here"

# Webhook security key (must match "Secret hash" in Chapa Dashboard)
CHAPA_WEBHOOK_SECRET="your_webhook_secret_here"
